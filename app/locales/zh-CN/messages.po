#~ msgid "rps.cry.0"
#~ msgstr "你完蛋了！"

#~ msgid "rps.cry.1"
#~ msgstr "来抱一个！"

#~ msgid "rps.cry.2"
#~ msgstr "剧透：你输了。"

#~ msgid "rps.cry.3"
#~ msgstr "我见过更吓人的喷嚏。"

#~ msgid "rps.cry.4"
#~ msgstr "概不退款！"

#~ msgid "rps.cry.5"
#~ msgstr "你还敢来，有胆量。"

#~ msgid "rps.cry.6"
#~ msgstr "祈祷吧！"

#~ msgid "rps.cry.7"
#~ msgstr "你不在一个段位，伙计。"

#~ msgid "rps.cry.8"
#~ msgstr "小心脚下——你已经掉进去了。"

#~ msgid "rps.cry.9"
#~ msgstr "这会留个印子。"

#~ msgid "rps.cry.10"
#~ msgstr "那是恐惧，还是你的香水？"

#~ msgid "rps.cry.11"
#~ msgstr "我的胜率高得离谱。"

#~ msgid "rps.cry.12"
#~ msgstr "幸运女神休假了。"

#~ msgid "rps.cry.13"
#~ msgstr "下跪，不然我重组你。"

#~ msgid "rps.cry.14"
#~ msgstr "我早就想赢了。"

#~ msgid "rps.cry.15"
#~ msgstr "怕的话就眨眨眼。"

#~ msgid "rps.cry.16"
#~ msgstr "赢这事，我先占了。"

#~ msgid "rps.cry.17"
#~ msgstr "你按错门铃了，伙计。"

#~ msgid "rps.cry.18"
#~ msgstr "惹我，你会哭。"

#~ msgid "rps.cry.19"
#~ msgstr "我打过更硬的NPC。"

#~ msgid "rps.cry.20"
#~ msgstr "练心肺也救不了你。"

#~ msgid "rps.cry.21"
#~ msgstr "感受我小小的不爽！"

#~ msgid "rps.cry.22"
#~ msgstr "谢谢游玩！"

#~ msgid "rps.cry.23"
#~ msgstr "你还能愤怒退游。"

#~ msgid "rps.cry.24"
#~ msgstr "从早饭起就没输过。"

#~ msgid "rps.cry.25"
#~ msgstr "挥手说拜拜！"

#~ msgid "rps.cry.26"
#~ msgstr "找错对手了，冠军。"

#~ msgid "rps.cry.27"
#~ msgstr "该练练技术了。"

#~ msgid "rps.death.0"
#~ msgstr "哎哟。真没礼貌。"

#~ msgid "rps.death.1"
#~ msgstr "这……也行？"

#~ msgid "rps.death.2"
#~ msgstr "值了。大概吧。"

#~ msgid "rps.death.3"
#~ msgstr "别告诉任何人。尤其是我妈。"

#~ msgid "rps.death.4"
#~ msgstr "这个得削……"

#~ msgid "rps.death.5"
#~ msgstr "GG……"

#~ msgid "rps.death.6"
#~ msgstr "我后悔……一些事……"

#~ msgid "rps.death.7"
#~ msgstr "把那个……截图……"

#~ msgid "rps.death.8"
#~ msgstr "教程里……没这招……"

#~ msgid "rps.death.9"
#~ msgstr "不该这样……卡了……"

#~ msgid "rps.death.10"
#~ msgstr "总会……复活的吧……"

#~ msgid "rps.death.11"
#~ msgstr "我的战利品……是租的……"

#~ msgid "rps.death.12"
#~ msgstr "我妈说……找份坐办公室的工作……"

#~ msgid "rps.death.13"
#~ msgstr "早该……闪开的……"

#~ msgid "rps.death.14"
#~ msgstr "肯定……开挂了……"

#~ msgid "rps.death.15"
#~ msgstr "愤怒退出……现实……"

#~ msgid "rps.death.16"
#~ msgstr "给我……五星好评……"

#~ msgid "rps.death.17"
#~ msgstr "这是……排位赛吗……？"

#~ msgid "rps.death.18"
#~ msgstr "取关了……"

#~ msgid "rps.death.19"
#~ msgstr "竟然……输给你……？"

#~ msgid "rps.death.20"
#~ msgstr "技术问题……我的……"

#~ msgid "rps.death.21"
#~ msgstr "GG，不打了……"

#~ msgid "rps.death.22"
#~ msgstr "给个……一星差评……"

#~ msgid "rps.death.23"
#~ msgstr "正在加载……来世……"

#~ msgid "rps.death.24"
#~ msgstr "这波……成梗了……"

#~ msgid "rps.death.25"
#~ msgstr "终于……能睡了……"

#~ msgid "rps.death.26"
#~ msgstr "把这段……发出去……"

#~ msgid "rps.death.27"
#~ msgstr "永久……挂机了……"

