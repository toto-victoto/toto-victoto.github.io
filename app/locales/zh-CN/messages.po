msgid "rps.cry.19"
msgstr "我杀过比你强的。"

msgid "rps.cry.20"
msgstr "无处可逃。"

msgid "rps.cry.21"
msgstr "感受我的怒火！"

msgid "rps.cry.22"
msgstr "这就是你的终点。"

msgid "rps.cry.23"
msgstr "认输吧。"

msgid "rps.cry.24"
msgstr "我从不落败。"

msgid "rps.cry.25"
