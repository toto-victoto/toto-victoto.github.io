msgid "rps.death.17"
msgstr "挺……有趣的……"

msgid "rps.death.18"
msgstr "不公平……"

msgid "rps.death.19"
msgstr "竟败……在你手里……"

msgid "rps.death.20"
msgstr "这就……结束了？"

msgid "rps.death.21"
msgstr "我认输……"

msgid "rps.death.22"
msgstr "诅咒你……"

msgid "rps.death.23"
msgstr "黑暗……"

msgid "rps.death.24"
msgstr "打得好……"

msgid "rps.death.25"
msgstr "唔……终于……"

msgid "rps.death.26"
msgstr "讲述我的故事……"

msgid "rps.death.27"
msgstr "终于……可以安息了……"

